EBIRD_API_KEY=replace_with_your_ebird_api_key

# Bird Profile information now uses the OpenAI Responses API directly.
# Use the same OpenAI API key you use for your WKH services.
OPENAI_API_KEY=replace_with_your_openai_api_key
BIRD_PROFILE_OPENAI_MODEL=gpt-5.6
BIRD_PROFILE_AI_TIMEOUT_MS=45000

# WKH Ask remains configured for the separate interactive chat features.
WKH_ASK_API_URL=https://ask.wildlifeknowledgehub.com/api/chat
WKH_ASK_TIMEOUT_MS=45000

# Species profile performance cache
PROFILE_CACHE_DAYS=365
IMAGE_CACHE_DAYS=30

# V11.4 persistent eBird area cache (default 6 hours)
EBIRD_AREA_CACHE_MINUTES=360
